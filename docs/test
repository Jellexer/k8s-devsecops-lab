# учёт SYSTEM и all-users
Get-ItemProperty "HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*",
                 "HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*",
                 "HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*" -ErrorAction SilentlyContinue |
  Where-Object DisplayName -like "Python*" |
  Select DisplayName, DisplayVersion, InstallLocation, UninstallString

# физические каталоги
Test-Path "C:\Program Files\Python312"
Test-Path "C:\Windows\System32\config\systemprofile\AppData\Local\Programs\Python"
