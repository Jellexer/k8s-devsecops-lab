$remote = "v=`$(rpm -q rhc); dnf -q check-update rhc >/dev/null 2>&1; echo `$v check=`$?"

$res = foreach ($h in $hosts) {
    $r = ssh -o ConnectTimeout=10 "$user@$h" $remote 2>&1 | ForEach-Object { "$_" }
