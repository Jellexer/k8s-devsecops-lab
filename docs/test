$user  = 'shared_user'
$hosts = Get-Content .\hosts.txt | ForEach-Object { $_.Trim() } |
         Where-Object { $_ -and $_ -notmatch '^#' }

$sec = Read-Host 'sudo password' -AsSecureString
$PW  = [System.Net.NetworkCredential]::new('', $sec).Password

# tr -d '\r' нужен, потому что PowerShell добавляет к паролю CRLF
$remote = (@'
before=$(rpm -q rhc)
tr -d '\r' | sudo -S -p '' dnf -y update rhc
rc=$?
echo RESULT rc=$rc before=$before after=$(rpm -q rhc)
'@ -split "\r?\n" | Where-Object { $_ }) -join '; '

$log = "rhc_update_$(Get-Date -Format 'yyyy-MM-dd_HHmm').log"

foreach ($h in $hosts) {
    "=== $h ===" | Tee-Object -Append -FilePath $log
    $PW | ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "$user@$h" $remote 2>&1 |
        ForEach-Object { "$_" } | Tee-Object -Append -FilePath $log
}
$PW = $null

"`n--- Итог ---"
Select-String -Path $log -Pattern '^===|^RESULT' | ForEach-Object Line
