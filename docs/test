@'
$user  = Read-Host 'SSH user'
$hosts = Get-Content .\hosts.txt | ForEach-Object { $_.Trim() } | Where-Object { $_ -and $_ -notmatch '^#' }

$sec = Read-Host 'sudo password' -AsSecureString
$PW  = [System.Net.NetworkCredential]::new('', $sec).Password

# tr -d '\r' убирает CRLF, который PowerShell добавляет к паролю
$remote = "before=`$(rpm -q rhc); tr -d '\r' | sudo -S -p '' dnf -y update rhc; rc=`$?; echo RESULT rc=`$rc before=`$before after=`$(rpm -q rhc)"

$log = "rhc_update_$(Get-Date -Format 'yyyy-MM-dd_HHmm').log"

foreach ($h in $hosts) {
    $hdr = "=== $h ==="
    Write-Host $hdr
    Add-Content $log $hdr
    $out = $PW | ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "$user@$h" $remote 2>&1 | ForEach-Object { "$_" }
    $out | Write-Host
    Add-Content $log $out
}
$PW = $null

Write-Host "`n--- Итог ---"
Select-String -Path $log -Pattern '^===|^RESULT' | ForEach-Object Line
'@ | Set-Content .\update.ps1 -Encoding UTF8


